{
  "expo": {
    "name": "Simple Video Editor",
    "slug": "simple-video-editor-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "simplevideoeditor",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0F13",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mario.simplevideoeditor",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0E0F13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to record voiceovers.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to pick videos and photos to edit."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save exported videos.",
          "granularPermissions": [
            "video"
          ]
        }
      ],
      "expo-sharing",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E0F13"
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "zh-Hans", "hi", "es", "ar", "fr", "bn", "pt", "ru", "id"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
